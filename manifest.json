{
  "manifest_version": 3,
  "name": "Domain Traffic Inspector",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "現在のタブの通信先をドメイン別に可視化し、ローカル環境でブロックルールを管理します",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Domain Traffic Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
